using System;
using System.Collections.Generic;
using System.Linq;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Flattens the library's report result types into denormalized ReportRow lists, ready for
    /// tabular/Excel export via LeapworkExcelReportWriter. Adding a new result type later only
    /// needs a new method here — the writer itself never needs to change.
    /// </summary>
    public static class ReportRowBuilder
    {
        public static List<ReportRow> FromRunListReportResult(RunListReportResult result)
        {
            var rows = new List<ReportRow>();

            if (!result.Success || result.Report is null)
            {
                rows.Add(new ReportRow
                {
                    RunListId = result.RunListId,
                    FlowStatus = "N/A",
                    Note = result.StatusMessage
                });
                return rows;
            }

            var report = result.Report;

            foreach (var item in report.RunItems)
            {
                rows.Add(new ReportRow
                {
                    RunListTitle = report.RunListTitle,
                    RunListId = report.RunListId,
                    ScheduleId = report.SelectedScheduleId,
                    ScheduleTitle = report.SelectedScheduleTitle,
                    RunId = report.Summary.RunId,
                    RunCreatedAt = report.Summary.CreatedAt,
                    RunStatus = report.Summary.Status.ToString(),
                    FlowId = item.FlowId,
                    FlowTitle = item.FlowTitle,
                    AgentId = item.AgentId,
                    AgentTitle = item.AgentTitle,
                    FlowStatus = item.HasRetrievalError ? "Retrieval Error" : item.Status.ToString(),
                    RetryAttempt = item.RetryAttempt,
                    FailReason = item.FailReason,
                    StartTime = item.StartTime,
                    Duration = item.Duration,
                    Note = item.RetrievalError
                });
            }

            foreach (var notExecuted in report.NotExecutedFlows)
            {
                rows.Add(new ReportRow
                {
                    RunListTitle = report.RunListTitle,
                    RunListId = report.RunListId,
                    ScheduleId = report.SelectedScheduleId,
                    ScheduleTitle = report.SelectedScheduleTitle,
                    RunId = report.Summary.RunId,
                    RunCreatedAt = report.Summary.CreatedAt,
                    RunStatus = report.Summary.Status.ToString(),
                    FlowId = notExecuted.FlowId,
                    FlowTitle = notExecuted.FlowTitle,
                    FlowStatus = "Not Executed",
                    Note = notExecuted.ExecutionState
                });
            }

            return rows;
        }

        public static List<ReportRow> FromRunListReportResults(IEnumerable<RunListReportResult> results) =>
            results.SelectMany(FromRunListReportResult).ToList();

        public static List<ReportRow> FromRunListTitleReportResult(RunListTitleReportResult result)
        {
            if (result.Matches.Count == 0)
            {
                return new List<ReportRow>
                {
                    new ReportRow
                    {
                        RunListTitle = result.RequestedTitle,
                        FlowStatus = "N/A",
                        Note = result.StatusMessage
                    }
                };
            }

            return result.Matches.SelectMany(FromRunListReportResult).ToList();
        }

        public static List<ReportRow> FromRunListTitleReportResults(IEnumerable<RunListTitleReportResult> results) =>
            results.SelectMany(FromRunListTitleReportResult).ToList();

        /// <summary>For the existing ScheduleId-only workflow. RunListTitle/RunListId are left null.</summary>
        public static List<ReportRow> FromScheduleRunReportResult(Guid scheduleId, ScheduleRunReportResult result)
        {
            var rows = new List<ReportRow>();

            if (!result.Success || result.Report is null)
            {
                rows.Add(new ReportRow
                {
                    ScheduleId = scheduleId,
                    FlowStatus = "N/A",
                    Note = result.NoCompletedRunReason
                });
                return rows;
            }

            var report = result.Report;

            foreach (var item in report.RunItems)
            {
                rows.Add(new ReportRow
                {
                    ScheduleId = scheduleId,
                    RunId = report.Summary.RunId,
                    RunCreatedAt = report.Summary.CreatedAt,
                    RunStatus = report.Summary.Status.ToString(),
                    FlowId = item.FlowId,
                    FlowTitle = item.FlowTitle,
                    AgentId = item.AgentId,
                    AgentTitle = item.AgentTitle,
                    FlowStatus = item.HasRetrievalError ? "Retrieval Error" : item.Status.ToString(),
                    RetryAttempt = item.RetryAttempt,
                    FailReason = item.FailReason,
                    StartTime = item.StartTime,
                    Duration = item.Duration,
                    Note = item.RetrievalError
                });
            }

            return rows;
        }
    }
}

