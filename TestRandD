using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Implements the RunListId-based workflow:
    /// RunListId → schedule hierarchy → matching ScheduleIds → candidate runs across all of them
    /// → latest Finished run → RunItemIds → per-RunItem detail → consolidated report.
    ///
    /// This is a separate class from <see cref="LeapworkReportService"/> per the RunList-to-Schedule
    /// resolution being a distinct responsibility; it reuses that service's candidate-collection and
    /// RunItem-retrieval logic rather than duplicating it, and does not modify the existing
    /// ScheduleId-based public method or its behavior.
    /// </summary>
    public sealed class LeapworkRunListReportService
    {
        private readonly LeapworkApiClient _client;
        private readonly LeapworkReportService _reportService;
        private readonly LeapworkClientOptions _options;

        public LeapworkRunListReportService(LeapworkApiClient client, LeapworkReportService reportService, LeapworkClientOptions options)
        {
            _client = client ?? throw new ArgumentNullException(nameof(client));
            _reportService = reportService ?? throw new ArgumentNullException(nameof(reportService));
            _options = options ?? throw new ArgumentNullException(nameof(options));
        }

        /// <summary>
        /// Retrieves the latest completed run for the given RunListId, across every schedule
        /// associated with it. Never starts a new execution. All calls are HTTP GET.
        /// </summary>
        /// <param name="runListId">Required. The Run List whose latest execution result is wanted.</param>
        /// <param name="lookbackDaysOverride">Optional override of DefaultLookbackDays.</param>
        public async Task<RunListReportResult> GetLatestCompletedRunReportForRunListAsync(
            Guid runListId,
            int? lookbackDaysOverride = null,
            CancellationToken ct = default)
        {
            if (runListId == Guid.Empty)
                throw new LeapworkValidationException("RunListId is required.");

            var lookbackDays = ResolveLookbackDays(lookbackDaysOverride);

            // Hierarchy is fetched fresh for a single-RunListId call; the batch overload below
            // fetches it once and shares it across every requested RunListId instead.
            var hierarchy = await _client.GetSchedulesHierarchyAsync(ct).ConfigureAwait(false);
            return await ResolveAndBuildReportAsync(runListId, hierarchy, lookbackDays, ct).ConfigureAwait(false);
        }

        /// <summary>
        /// Retrieves the latest completed run for each of several RunListIds in one operation.
        /// The schedule hierarchy is retrieved exactly once and reused for every RunListId.
        /// Every requested RunListId produces exactly one result in the returned list, in the
        /// same order supplied — including RunListIds with no associated schedule, no historical
        /// runs, no finished run, or that hit an API error. A failure processing one RunListId is
        /// isolated to that entry and does not stop the remaining RunListIds from being processed.
        /// </summary>
        /// <param name="runListIds">Required. One or more RunListIds to process.</param>
        /// <param name="lookbackDaysOverride">Optional override of DefaultLookbackDays, applied to all.</param>
        public async Task<IReadOnlyList<RunListReportResult>> GetLatestCompletedRunReportForRunListsAsync(
            IEnumerable<Guid> runListIds,
            int? lookbackDaysOverride = null,
            CancellationToken ct = default)
        {
            if (runListIds is null)
                throw new ArgumentNullException(nameof(runListIds));

            var ids = runListIds.ToList();
            if (ids.Count == 0)
                throw new LeapworkValidationException("At least one RunListId is required.");
            if (ids.Any(id => id == Guid.Empty))
                throw new LeapworkValidationException("RunListIds must not contain an empty Guid.");

            var lookbackDays = ResolveLookbackDays(lookbackDaysOverride);

            // Schedule hierarchy retrieved once and reused for every RunListId in this batch.
            List<ScheduleHierarchyEntry> hierarchy;
            try
            {
                hierarchy = await _client.GetSchedulesHierarchyAsync(ct).ConfigureAwait(false);
            }
            catch (LeapworkApiException ex)
            {
                // The hierarchy fetch is shared infrastructure for the whole batch; if it fails,
                // every RunListId fails the same way, but each still gets its own explicit result
                // rather than throwing out of this method and losing the other RunListIds.
                return ids
                    .Select(id => RunListReportResult.Error(id, $"Failed to retrieve schedule hierarchy: {ex.Message}"))
                    .ToList();
            }

            var results = new List<RunListReportResult>(ids.Count);
            foreach (var runListId in ids)
            {
                try
                {
                    var result = await ResolveAndBuildReportAsync(runListId, hierarchy, lookbackDays, ct).ConfigureAwait(false);
                    results.Add(result);
                }
                catch (Exception ex)
                {
                    // Intentionally broad: this is the isolation boundary for one RunListId's
                    // processing. Any failure here (API, validation, or otherwise) must not
                    // prevent the remaining RunListIds in this batch from being processed. The
                    // exception message never contains the AccessKey (see LeapworkApiException).
                    results.Add(RunListReportResult.Error(runListId, ex.Message));
                }
            }

            return results;
        }

        /// <summary>
        /// Retrieves the latest completed run for each of several Run List titles. A title is not
        /// guaranteed unique, so each requested title can resolve to zero, one, or several
        /// RunListInfoIds — every match found is processed and returned under that title's entry.
        /// The schedule hierarchy is retrieved exactly once and reused for every title. Matching is
        /// case-insensitive on RunListTitle. Every requested title produces exactly one
        /// RunListTitleReportResult, in the same order supplied, even when it has zero matches.
        /// </summary>
        /// <param name="runListTitles">Required. One or more Run List titles to resolve and process.</param>
        /// <param name="lookbackDaysOverride">Optional override of DefaultLookbackDays, applied to all.</param>
        public async Task<IReadOnlyList<RunListTitleReportResult>> GetLatestCompletedRunReportForRunListTitlesAsync(
            IEnumerable<string> runListTitles,
            int? lookbackDaysOverride = null,
            CancellationToken ct = default)
        {
            if (runListTitles is null)
                throw new ArgumentNullException(nameof(runListTitles));

            var titles = runListTitles.Where(t => !string.IsNullOrWhiteSpace(t)).ToList();
            if (titles.Count == 0)
                throw new LeapworkValidationException("At least one RunList title is required.");

            var lookbackDays = ResolveLookbackDays(lookbackDaysOverride);

            List<ScheduleHierarchyEntry> hierarchy;
            try
            {
                hierarchy = await _client.GetSchedulesHierarchyAsync(ct).ConfigureAwait(false);
            }
            catch (LeapworkApiException ex)
            {
                return titles
                    .Select(t => new RunListTitleReportResult
                    {
                        RequestedTitle = t,
                        StatusMessage = $"Failed to retrieve schedule hierarchy: {ex.Message}"
                    })
                    .ToList();
            }

            var results = new List<RunListTitleReportResult>(titles.Count);

            foreach (var title in titles)
            {
                var matchingRunListIds = hierarchy
                    .Where(h => h.RunListInfoId.HasValue &&
                                string.Equals(h.RunListTitle, title, StringComparison.OrdinalIgnoreCase))
                    .Select(h => h.RunListInfoId!.Value)
                    .Distinct()
                    .ToList();

                if (matchingRunListIds.Count == 0)
                {
                    results.Add(new RunListTitleReportResult
                    {
                        RequestedTitle = title,
                        StatusMessage = "No Run List found with this title"
                    });
                    continue;
                }

                var matches = new List<RunListReportResult>(matchingRunListIds.Count);
                foreach (var runListId in matchingRunListIds)
                {
                    try
                    {
                        var singleResult = await ResolveAndBuildReportAsync(runListId, hierarchy, lookbackDays, ct).ConfigureAwait(false);
                        matches.Add(singleResult);
                    }
                    catch (Exception ex)
                    {
                        // Same isolation boundary as the RunListId batch overload: one match's
                        // failure must not lose the others under this title.
                        matches.Add(RunListReportResult.Error(runListId, ex.Message));
                    }
                }

                results.Add(new RunListTitleReportResult
                {
                    RequestedTitle = title,
                    Matches = matches
                });
            }

            return results;
        }

        private int ResolveLookbackDays(int? lookbackDaysOverride)
        {
            var lookbackDays = lookbackDaysOverride ?? _options.DefaultLookbackDays;
            if (lookbackDays <= 0)
                throw new LeapworkValidationException("LookbackDays must be a positive number of days.");
            return lookbackDays;
        }

        /// <summary>
        /// Resolves one RunListId against an already-fetched hierarchy and builds its report.
        /// Shared by both the single-RunListId and batch overloads so their behavior stays identical.
        /// </summary>
        private async Task<RunListReportResult> ResolveAndBuildReportAsync(
            Guid runListId, List<ScheduleHierarchyEntry> hierarchy, int lookbackDays, CancellationToken ct)
        {
            // 1-3. Resolve schedules associated with this RunListId via the hierarchy.
            var matches = hierarchy.Where(h => h.RunListInfoId == runListId).ToList();

            if (matches.Count == 0)
                return RunListReportResult.NoAssociatedSchedule(runListId);

            var scheduleIds = matches.Select(m => m.ScheduleId).Distinct().ToList();

            // 4-6. Candidate RunIds and details across every associated schedule.
            var candidates = await _reportService.CollectFinishedCandidatesAsync(scheduleIds, lookbackDays, ct).ConfigureAwait(false);

            // 7. Select the latest Finished run across all associated schedules.
            var latest = LeapworkReportService.SelectLatestFinished(candidates);

            if (latest is null)
                return RunListReportResult.NoCompletedRun(runListId);

            // 8. Reuse existing RunItem retrieval and report generation.
            var runItems = await _reportService.RetrieveRunItemResultsAsync(latest.RunId, ct).ConfigureAwait(false);

            var selectedScheduleMatch = matches.First(m => m.ScheduleId == latest.ScheduleId);
            var runListTitle = matches.Select(m => m.RunListTitle).FirstOrDefault(t => !string.IsNullOrEmpty(t));

            var notExecutedFlows = _options.IncludeNotExecutedFlows
                ? await ResolveNotExecutedFlowsAsync(selectedScheduleMatch, runItems, ct).ConfigureAwait(false)
                : new List<NotExecutedFlow>();

            var report = new RunListRunReport
            {
                RunListId = runListId,
                RunListTitle = runListTitle,
                SelectedScheduleId = latest.ScheduleId,
                SelectedScheduleTitle = selectedScheduleMatch.ScheduleTitle,
                Summary = latest,
                RunItems = runItems,
                Reconciliation = LeapworkReportService.CalculateReconciliation(latest, runItems),
                NotExecutedFlows = notExecutedFlows
            };

            return RunListReportResult.Ok(report);
        }

        /// <summary>
        /// Resolves flows configured on the selected schedule's Run List steps that have no
        /// matching RunItem in the selected run (spec section 13). Matching is by FlowId presence
        /// among the retrieved RunItems; each configured flow is still reported per RunListStepId
        /// so the same FlowId appearing in multiple steps is preserved as separate entries. Never
        /// counted toward Passed/Failed/Done — this list is purely additive/informational.
        /// A step whose flowInfos call fails is skipped rather than failing the whole report,
        /// since this feature is optional and supplementary to the core run report.
        /// </summary>
        private async Task<List<NotExecutedFlow>> ResolveNotExecutedFlowsAsync(
            ScheduleHierarchyEntry selectedSchedule, List<RunItemResult> runItems, CancellationToken ct)
        {
            var executedFlowIds = new HashSet<Guid>(
                runItems.Where(i => i.FlowId.HasValue).Select(i => i.FlowId!.Value));

            var notExecuted = new List<NotExecutedFlow>();

            foreach (var runListStepId in selectedSchedule.RunListStepIds)
            {
                List<ConfiguredFlowInfo> configuredFlows;
                try
                {
                    configuredFlows = await _client.GetConfiguredFlowInfosAsync(runListStepId, ct).ConfigureAwait(false);
                }
                catch (LeapworkApiException)
                {
                    continue;
                }

                foreach (var flow in configuredFlows)
                {
                    if (!executedFlowIds.Contains(flow.FlowId))
                    {
                        notExecuted.Add(new NotExecutedFlow
                        {
                            RunListStepId = runListStepId,
                            FlowId = flow.FlowId,
                            FlowTitle = flow.FlowTitle
                        });
                    }
                }
            }

            return notExecuted;
        }
    }
}

