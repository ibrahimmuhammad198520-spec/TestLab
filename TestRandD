using System;
using System.Net.Http;
using System.Text;
using Leapwork.ReportClient;

/// <summary>
/// LEAPWORK C# block smoke test for Leapwork.ReportClient.
/// String-in / string-out, no async at the block boundary (uses GetAwaiter().GetResult()
/// internally), single class only — matches the LEAPWORK C# block execution model.
///
/// This is compiled as a console entry point, so it needs a static Main. Inputs are read
/// positionally from args[]; if LEAPWORK doesn't pass command-line args to the block, adjust
/// ReadInput() below to pull from whatever mechanism it actually uses (environment variables,
/// stdin, or a LEAPWORK-supplied Args/Parameters object) — tell me which one your block
/// template uses and I'll match it exactly instead of guessing.
///
/// Expected order: controllerUrl accessKey scheduleId runListId lookbackDays runItemIds
/// Pass an empty string ("") for scheduleId or runListId to skip that workflow.
/// runItemIds is a comma-separated list of RunItemId GUIDs (e.g. "id1,id2,id3"); pass ""
/// to skip. Each is fetched directly via GetRunItemAsync, bypassing run selection entirely —
/// useful for checking specific RunItems without going through a ScheduleId/RunListId.
/// </summary>
public class LeapworkReportSmokeTest
{
    public static void Main(string[] args)
    {
        var controllerUrl = ReadInput(args, 0, "CONTROLLER_URL");
        var accessKey = ReadInput(args, 1, "ACCESS_KEY");
        var scheduleIdRaw = ReadInput(args, 2, "SCHEDULE_ID");
        var runListIdRaw = ReadInput(args, 3, "RUN_LIST_ID");
        var lookbackDaysRaw = ReadInput(args, 4, "LOOKBACK_DAYS");
        var runItemIdsRaw = ReadInput(args, 5, "RUN_ITEM_IDS");

        var result = RunTest(controllerUrl, accessKey, scheduleIdRaw, runListIdRaw, lookbackDaysRaw, runItemIdsRaw);
        Console.WriteLine(result);
    }

    /// <summary>Reads a positional arg if present, otherwise falls back to an environment variable.</summary>
    private static string ReadInput(string[] args, int index, string envVarFallback)
    {
        if (args.Length > index && !string.IsNullOrWhiteSpace(args[index]))
            return args[index];

        return Environment.GetEnvironmentVariable(envVarFallback) ?? string.Empty;
    }

    public static string RunTest(string controllerUrl, string accessKey, string scheduleIdRaw, string runListIdRaw, string lookbackDaysRaw, string runItemIdsRaw = "")
    {
        var output = new StringBuilder();

        try
        {
            var options = new LeapworkClientOptions
            {
                ControllerUrl = controllerUrl,
                AccessKey = accessKey,
                DefaultLookbackDays = int.TryParse(lookbackDaysRaw, out var lb) && lb > 0 ? lb : 30
            };

            using var httpClient = new HttpClient();
            var apiClient = new LeapworkApiClient(httpClient, options);
            var reportService = new LeapworkReportService(apiClient, options);
            var runListService = new LeapworkRunListReportService(apiClient, reportService, options);

            // ---- Test 1: existing ScheduleId workflow ----
            if (Guid.TryParse(scheduleIdRaw, out var scheduleId) && scheduleId != Guid.Empty)
            {
                output.AppendLine("=== ScheduleId workflow ===");
                var scheduleResult = reportService.GetLatestCompletedRunReportAsync(scheduleId).GetAwaiter().GetResult();
                AppendScheduleResult(output, scheduleResult);
            }
            else
            {
                output.AppendLine("=== ScheduleId workflow SKIPPED (no valid ScheduleId supplied) ===");
            }

            // ---- Test 2: RunListId workflow ----
            if (Guid.TryParse(runListIdRaw, out var runListId) && runListId != Guid.Empty)
            {
                output.AppendLine();
                output.AppendLine("=== RunListId workflow ===");
                var runListResult = runListService.GetLatestCompletedRunReportForRunListAsync(runListId).GetAwaiter().GetResult();
                AppendRunListResult(output, runListResult);
            }
            else
            {
                output.AppendLine();
                output.AppendLine("=== RunListId workflow SKIPPED (no valid RunListId supplied) ===");
            }

            // ---- Test 3: direct RunItemId lookup (bypasses run selection entirely) ----
            output.AppendLine();
            if (!string.IsNullOrWhiteSpace(runItemIdsRaw))
            {
                output.AppendLine("=== Direct RunItemId lookup ===");
                var runItemIds = runItemIdsRaw
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                output.AppendLine($"Requested {runItemIds.Length} RunItemId(s).");

                foreach (var raw in runItemIds)
                {
                    if (!Guid.TryParse(raw, out var runItemId))
                    {
                        output.AppendLine($"  SKIPPED (not a valid Guid): '{raw}'");
                        continue;
                    }

                    try
                    {
                        var item = apiClient.GetRunItemAsync(runItemId).GetAwaiter().GetResult();
                        AppendRunItemLine(output, item);
                    }
                    catch (LeapworkApiException ex)
                    {
                        output.AppendLine($"  --- RunItem {runItemId} ---");
                        output.AppendLine($"    RETRIEVAL ERROR: {ex.Message}");
                    }
                }
            }
            else
            {
                output.AppendLine("=== Direct RunItemId lookup SKIPPED (no RunItemIds supplied) ===");
            }
        }
        catch (LeapworkValidationException ex)
        {
            output.AppendLine("VALIDATION ERROR: " + ex.Message);
        }
        catch (LeapworkApiException ex)
        {
            // Never contains the AccessKey — safe to log/output as-is.
            output.AppendLine("API ERROR: " + ex.Message);
        }
        catch (Exception ex)
        {
            output.AppendLine("UNEXPECTED ERROR: " + ex.Message);
        }

        return output.ToString();
    }

    private static void AppendScheduleResult(StringBuilder output, ScheduleRunReportResult result)
    {
        if (!result.Success)
        {
            output.AppendLine("No report: " + result.NoCompletedRunReason);
            return;
        }

        var report = result.Report!;
        output.AppendLine($"RunId: {report.Summary.RunId} | CreatedAt: {report.Summary.CreatedAt:u} | Status: {report.Summary.Status}");
        output.AppendLine($"Official totals -> Passed: {report.Summary.Passed}  Failed: {report.Summary.Failed}  Done: {report.Summary.Done}  Total: {report.Summary.Total}");

        if (!report.Reconciliation.Matches)
        {
            output.AppendLine("RECONCILIATION WARNING: " + report.Reconciliation.Warning);
        }
        else
        {
            output.AppendLine("Reconciliation: official and calculated totals match.");
        }

        output.AppendLine($"RunItems ({report.RunItems.Count}):");
        foreach (var item in report.RunItems)
        {
            AppendRunItemLine(output, item);
        }
    }

    private static void AppendRunListResult(StringBuilder output, RunListReportResult result)
    {
        if (!result.Success)
        {
            output.AppendLine("No report: " + result.StatusMessage);
            return;
        }

        var report = result.Report!;
        output.AppendLine($"RunListId: {report.RunListId} ({report.RunListTitle ?? "(no title)"})");
        output.AppendLine($"Selected ScheduleId: {report.SelectedScheduleId} ({report.SelectedScheduleTitle ?? "(no title)"})");
        output.AppendLine($"RunId: {report.Summary.RunId} | CreatedAt: {report.Summary.CreatedAt:u} | Status: {report.Summary.Status}");
        output.AppendLine($"Official totals -> Passed: {report.Summary.Passed}  Failed: {report.Summary.Failed}  Done: {report.Summary.Done}  Total: {report.Summary.Total}");

        if (!report.Reconciliation.Matches)
        {
            output.AppendLine("RECONCILIATION WARNING: " + report.Reconciliation.Warning);
        }
        else
        {
            output.AppendLine("Reconciliation: official and calculated totals match.");
        }

        output.AppendLine($"RunItems ({report.RunItems.Count}):");
        foreach (var item in report.RunItems)
        {
            AppendRunItemLine(output, item);
        }
    }

    private static void AppendRunItemLine(StringBuilder output, RunItemResult item)
    {
        output.AppendLine($"  --- RunItem {item.RunItemId} ---");
        output.AppendLine($"    RunItemId:      {item.RunItemId}");

        if (item.HasRetrievalError)
        {
            output.AppendLine($"    RETRIEVAL ERROR: {item.RetrievalError}");
            return;
        }

        output.AppendLine($"    FlowId:         {item.FlowId}");
        output.AppendLine($"    FlowTitle:      {item.FlowTitle}");
        output.AppendLine($"    AgentId:        {item.AgentId}");
        output.AppendLine($"    AgentTitle:     {item.AgentTitle}");
        output.AppendLine($"    Status:         {item.Status} (raw: {item.RawStatus})");
        output.AppendLine($"    RetryAttempt:   {item.RetryAttempt}");
        output.AppendLine($"    FailReason:     {item.FailReason ?? "none"}");
        output.AppendLine($"    StartTime:      {item.StartTime:u}");
        output.AppendLine($"    Duration:       {item.Duration}");
    }
}
