using System;
using System.Collections.Generic;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Lifecycle status of a Run (the whole schedule execution), per spec section 5.
    /// </summary>
    public enum RunStatus
    {
        Queued,
        Executing,
        Finished,
        /// <summary>Any value returned by the API that is not one of the known lifecycle states.</summary>
        Unknown
    }

    /// <summary>
    /// Outcome status of an individual RunItem, per spec section 10.
    /// Unknown values are preserved via RawStatus rather than silently coerced.
    /// </summary>
    public enum RunItemStatus
    {
        Passed,
        Failed,
        Done,
        Cancelled,
        Error,
        IsProcessing,
        NoStatus,
        Unknown
    }

    /// <summary>Connection and behavior configuration for the client.</summary>
    public sealed class LeapworkClientOptions
    {
        /// <summary>Controller API base address, e.g. https://controller.example.com/api/v4/</summary>
        public string ControllerUrl { get; set; } = string.Empty;

        /// <summary>Leapwork API access key. Never logged or included in exception messages.</summary>
        public string AccessKey { get; set; } = string.Empty;

        /// <summary>Default lookback window in days when the caller does not override it.</summary>
        public int DefaultLookbackDays { get; set; } = 30;

        /// <summary>Optional per-request timeout override.</summary>
        public TimeSpan? RequestTimeout { get; set; }

        /// <summary>
        /// When true, the RunListId workflow also resolves flows configured in the Run List's
        /// steps that did not generate a RunItem in the selected run, via
        /// GET /steps/{runListStepId}/flowInfos. Default false: retains prior behavior
        /// (report only actual RunItems, no extra API calls).
        /// </summary>
        public bool IncludeNotExecutedFlows { get; set; } = false;
    }

    /// <summary>Run-level summary as required by spec section 8.</summary>
    public sealed class RunSummary
    {
        public Guid ScheduleId { get; set; }
        public Guid RunId { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
        public RunStatus Status { get; set; }
        public string RawStatus { get; set; } = string.Empty;
        public int Passed { get; set; }
        public int Failed { get; set; }
        public int Done { get; set; }
        public int Total { get; set; }
    }

    /// <summary>RunItem-level result as required by spec section 9.</summary>
    public sealed class RunItemResult
    {
        public Guid RunItemId { get; set; }
        public Guid? FlowId { get; set; }
        public string? FlowTitle { get; set; }
        public Guid? AgentId { get; set; }
        public string? AgentTitle { get; set; }
        public RunItemStatus Status { get; set; }
        public string RawStatus { get; set; } = string.Empty;
        /// <summary>Supporting value only; root-level Status is authoritative per spec section 9.</summary>
        public string? FlowInfoStatus { get; set; }
        public int RetryAttempt { get; set; }
        public string? FailReason { get; set; }
        public DateTimeOffset? StartTime { get; set; }
        public DateTimeOffset? EndTime { get; set; }
        public TimeSpan? Duration { get; set; }

        /// <summary>
        /// Populated when this RunItem could not be retrieved or parsed. The RunItemId is still
        /// preserved and reported per spec section 13 ("RunItem retrieval failure").
        /// </summary>
        public string? RetrievalError { get; set; }

        public bool HasRetrievalError => !string.IsNullOrEmpty(RetrievalError);
    }

    /// <summary>
    /// Outcome of a report request. Either Report is populated, or NoCompletedRunFound explains
    /// why no report could be produced (spec section 13 - "No Finished run found").
    /// </summary>
    public sealed class ScheduleRunReportResult
    {
        public bool Success { get; set; }
        public ScheduleRunReport? Report { get; set; }
        public string? NoCompletedRunReason { get; set; }

        public static ScheduleRunReportResult Ok(ScheduleRunReport report) =>
            new ScheduleRunReportResult { Success = true, Report = report };

        public static ScheduleRunReportResult NoRun(string reason) =>
            new ScheduleRunReportResult { Success = false, NoCompletedRunReason = reason };
    }

    /// <summary>RunItem-based totals calculated from the actually retrieved RunItems, for
    /// reconciliation against the official Passed/Failed/Done/Total from the run summary.</summary>
    public sealed class RunItemTotals
    {
        public int Passed { get; set; }
        public int Failed { get; set; }
        public int Done { get; set; }
        public int Total { get; set; }
    }

    /// <summary>
    /// Comparison between the official run-level totals (from GET /run/{runId}) and totals
    /// calculated from the retrieved RunItems. The official totals are always retained as-is;
    /// this is informational only and never overwrites them.
    /// </summary>
    public sealed class ReconciliationResult
    {
        public RunItemTotals CalculatedTotals { get; set; } = new RunItemTotals();
        public bool Matches { get; set; }
        /// <summary>Null when Matches is true; otherwise explains which figures disagree and why they might.</summary>
        public string? Warning { get; set; }
    }

    /// <summary>The consolidated response described in spec section 12.</summary>
    public sealed class ScheduleRunReport
    {
        public RunSummary Summary { get; set; } = null!;
        public List<RunItemResult> RunItems { get; set; } = new List<RunItemResult>();
        public ReconciliationResult Reconciliation { get; set; } = new ReconciliationResult();
    }

    /// <summary>One flattened schedule entry from GET /schedules/hierarchy.</summary>
    public sealed class ScheduleHierarchyEntry
    {
        public Guid ScheduleId { get; set; }
        public string? ScheduleTitle { get; set; }
        public bool? Enabled { get; set; }
        /// <summary>The RunListId this schedule is associated with, when present.</summary>
        public Guid? RunListInfoId { get; set; }
        public string? RunListTitle { get; set; }
        /// <summary>
        /// RunListStepIds configured on this schedule. Only populated/used when
        /// IncludeNotExecutedFlows is enabled — otherwise no extra API calls are made for it.
        /// </summary>
        public List<Guid> RunListStepIds { get; set; } = new List<Guid>();
    }

    /// <summary>A flow configured on a Run List step, from GET /steps/{runListStepId}/flowInfos.</summary>
    public sealed class ConfiguredFlowInfo
    {
        public Guid RunListStepId { get; set; }
        public Guid FlowId { get; set; }
        public string? FlowTitle { get; set; }
    }

    /// <summary>
    /// A flow that was configured on a Run List step but did not generate a RunItem in the
    /// selected run. Never counted toward Passed/Failed/Done totals.
    /// </summary>
    public sealed class NotExecutedFlow
    {
        public Guid RunListStepId { get; set; }
        public Guid FlowId { get; set; }
        public string? FlowTitle { get; set; }
        public string ExecutionState { get; set; } = "Not Executed \u2013 no RunItem generated";
    }

    /// <summary>Result of resolving and reporting a single RunListId (spec: RunListId-based workflow).</summary>
    public sealed class RunListRunReport
    {
        public Guid RunListId { get; set; }
        public string? RunListTitle { get; set; }
        public Guid SelectedScheduleId { get; set; }
        public string? SelectedScheduleTitle { get; set; }
        public RunSummary Summary { get; set; } = null!;
        public List<RunItemResult> RunItems { get; set; } = new List<RunItemResult>();
        public ReconciliationResult Reconciliation { get; set; } = new ReconciliationResult();
        /// <summary>
        /// Configured flows with no matching RunItem in the selected run. Always empty unless
        /// IncludeNotExecutedFlows was enabled on the client options for this request.
        /// </summary>
        public List<NotExecutedFlow> NotExecutedFlows { get; set; } = new List<NotExecutedFlow>();
    }

    /// <summary>
    /// Outcome of a RunListId-based report request. Success is false with StatusMessage set to
    /// either "No associated schedule found" or "No completed run found" when applicable.
    /// </summary>
    public sealed class RunListReportResult
    {
        public Guid RunListId { get; set; }
        public bool Success { get; set; }
        public RunListRunReport? Report { get; set; }
        public string? StatusMessage { get; set; }

        public static RunListReportResult Ok(RunListRunReport report) =>
            new RunListReportResult { RunListId = report.RunListId, Success = true, Report = report };

        public static RunListReportResult NoAssociatedSchedule(Guid runListId) =>
            new RunListReportResult { RunListId = runListId, Success = false, StatusMessage = "No associated schedule found" };

        public static RunListReportResult NoCompletedRun(Guid runListId) =>
            new RunListReportResult { RunListId = runListId, Success = false, StatusMessage = "No completed run found" };

        /// <summary>
        /// A RunListId whose processing hit an API or unexpected error, isolated from the rest of
        /// a batch request. The message never contains the AccessKey.
        /// </summary>
        public static RunListReportResult Error(Guid runListId, string message) =>
            new RunListReportResult { RunListId = runListId, Success = false, StatusMessage = $"Error: {message}" };
    }
}

