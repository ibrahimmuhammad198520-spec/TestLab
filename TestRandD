using System;
using System.Collections.Generic;
using System.Linq;
using ClosedXML.Excel;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Writes a list of ReportRow to a real .xlsx file: RunList -> Schedule -> Run -> Flow,
    /// as one denormalized table with Excel outline grouping layered on top for a collapsible
    /// hierarchy view. Requires the ClosedXML NuGet package (dotnet add package ClosedXML).
    /// </summary>
    public static class LeapworkExcelReportWriter
    {
        private static readonly (string Header, Func<ReportRow, object?> Value)[] Columns =
        {
            ("RunList Title", r => r.RunListTitle),
            ("RunList Id", r => r.RunListId),
            ("Schedule Id", r => r.ScheduleId),
            ("Schedule Title", r => r.ScheduleTitle),
            ("Run Id", r => r.RunId),
            ("Run Created At", r => r.RunCreatedAt?.LocalDateTime),
            ("Run Status", r => r.RunStatus),
            ("Flow Id", r => r.FlowId),
            ("Flow Title", r => r.FlowTitle),
            ("Agent Id", r => r.AgentId),
            ("Agent Title", r => r.AgentTitle),
            ("Flow Status", r => r.FlowStatus),
            ("Retry Attempt", r => r.RetryAttempt),
            ("Fail Reason", r => r.FailReason),
            ("Start Time", r => r.StartTime?.LocalDateTime),
            ("Duration", r => r.Duration?.ToString(@"hh\:mm\:ss")),
            ("Note", r => r.Note)
        };

        /// <summary>
        /// Writes rows to outputPath, sorted and grouped by RunList Title -> Schedule Id -> Flow
        /// Title for a deterministic, collapsible hierarchy. Overwrites an existing file at that path.
        /// </summary>
        public static void Write(IEnumerable<ReportRow> rows, string outputPath, string sheetName = "Flow Status Report")
        {
            var ordered = rows
                .OrderBy(r => r.RunListTitle ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.ScheduleId)
                .ThenBy(r => r.FlowTitle ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.RetryAttempt ?? 0)
                .ToList();

            using var workbook = new XLWorkbook();
            var ws = workbook.Worksheets.Add(sheetName);

            var flowStatusColumnIndex = -1;
            for (var c = 0; c < Columns.Length; c++)
            {
                var cell = ws.Cell(1, c + 1);
                cell.Value = Columns[c].Header;
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#DDEBF7");
                if (Columns[c].Header == "Flow Status") flowStatusColumnIndex = c + 1;
            }

            string? currentRunListTitle = null;
            Guid? currentScheduleId = null;
            var rowNum = 2;

            foreach (var row in ordered)
            {
                var isNewRunList = !string.Equals(currentRunListTitle, row.RunListTitle, StringComparison.OrdinalIgnoreCase);
                var isNewSchedule = isNewRunList || currentScheduleId != row.ScheduleId;

                for (var c = 0; c < Columns.Length; c++)
                {
                    var value = Columns[c].Value(row);
                    var cell = ws.Cell(rowNum, c + 1);
                    SetCellValue(cell, value);
                }

                // Outline levels give a collapsible hierarchy on top of the flat table:
                // level 1 = a new Schedule group (also true for a new RunList's first row),
                // level 2 = every individual flow row within it.
                ws.Row(rowNum).OutlineLevel = isNewSchedule ? 1 : 2;

                if (flowStatusColumnIndex > 0)
                    ApplyStatusColor(ws.Cell(rowNum, flowStatusColumnIndex), row.FlowStatus);

                currentRunListTitle = row.RunListTitle;
                currentScheduleId = row.ScheduleId;
                rowNum++;
            }

            ws.SheetView.FreezeRows(1);
            ws.Columns().AdjustToContents();
            ws.RangeUsed()?.SetAutoFilter();

            workbook.SaveAs(outputPath);
        }

        private static void SetCellValue(IXLCell cell, object? value)
        {
            switch (value)
            {
                case null:
                    cell.Value = string.Empty;
                    break;
                case Guid g:
                    cell.Value = g == Guid.Empty ? string.Empty : g.ToString();
                    break;
                case DateTime dt:
                    cell.Value = dt;
                    cell.Style.DateFormat.Format = "yyyy-mm-dd hh:mm:ss";
                    break;
                case int i:
                    cell.Value = i;
                    break;
                default:
                    cell.Value = value.ToString();
                    break;
            }
        }

        private static void ApplyStatusColor(IXLCell cell, string status)
        {
            var color = status switch
            {
                "Passed" => XLColor.FromHtml("#C6EFCE"),
                "Failed" or "Error" or "Retrieval Error" => XLColor.FromHtml("#FFC7CE"),
                "Not Executed" or "Cancelled" => XLColor.FromHtml("#F2F2F2"),
                "IsProcessing" or "NoStatus" or "Unknown" => XLColor.FromHtml("#FFEB9C"),
                _ => (XLColor?)null
            };

            if (color.HasValue)
                cell.Style.Fill.BackgroundColor = color.Value;
        }
    }
}

