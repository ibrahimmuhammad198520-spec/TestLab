using System;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// One denormalized row for tabular/Excel export: RunList -> Schedule -> Run -> Flow, with
    /// parent context repeated on every row so the table works standalone for filtering, sorting,
    /// and pivoting, independent of any visual grouping applied on top of it.
    /// </summary>
    public sealed class ReportRow
    {
        public string? RunListTitle { get; set; }
        public Guid? RunListId { get; set; }

        public Guid ScheduleId { get; set; }
        public string? ScheduleTitle { get; set; }

        public Guid? RunId { get; set; }
        public DateTimeOffset? RunCreatedAt { get; set; }
        public string? RunStatus { get; set; }

        public Guid? FlowId { get; set; }
        public string? FlowTitle { get; set; }
        public Guid? AgentId { get; set; }
        public string? AgentTitle { get; set; }

        /// <summary>Display status for this row: RunItem Status, "Not Executed", "Retrieval Error", or "N/A".</summary>
        public string FlowStatus { get; set; } = string.Empty;
        public int? RetryAttempt { get; set; }
        public string? FailReason { get; set; }
        public DateTimeOffset? StartTime { get; set; }
        public TimeSpan? Duration { get; set; }

        /// <summary>Free-text context: retrieval error, "no associated schedule", not-executed reason, etc.</summary>
        public string? Note { get; set; }
    }
}

