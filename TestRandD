using System;
using System.Net.Http;
using System.Text;
using Leapwork.ReportClient;

/// <summary>
/// LEAPWORK C# block smoke test for Leapwork.ReportClient.
/// String-in / string-out, no async at the block boundary (uses GetAwaiter().GetResult()
/// internally), single class only — matches the LEAPWORK C# block execution model.
///
/// Adjust the entry-point method name/signature below to whatever your LEAPWORK C# block
/// template actually expects (e.g. a specific method name, or reading inputs from a
/// LEAPWORK-supplied Args/Parameters object instead of method parameters) — I don't have
/// your exact block template, so this uses plain string parameters as the safest common
/// denominator. If your blocks use a different input mechanism, tell me and I'll adjust.
/// </summary>
public class LeapworkReportSmokeTest
{
    public string RunTest(string controllerUrl, string accessKey, string scheduleIdRaw, string runListIdRaw, string lookbackDaysRaw)
    {
        var output = new StringBuilder();

        try
        {
            var options = new LeapworkClientOptions
            {
                ControllerUrl = controllerUrl,
                AccessKey = accessKey,
                DefaultLookbackDays = int.TryParse(lookbackDaysRaw, out var lb) && lb > 0 ? lb : 30
            };

            using var httpClient = new HttpClient();
            var apiClient = new LeapworkApiClient(httpClient, options);
            var reportService = new LeapworkReportService(apiClient, options);
            var runListService = new LeapworkRunListReportService(apiClient, reportService, options);

            // ---- Test 1: existing ScheduleId workflow ----
            if (Guid.TryParse(scheduleIdRaw, out var scheduleId) && scheduleId != Guid.Empty)
            {
                output.AppendLine("=== ScheduleId workflow ===");
                var scheduleResult = reportService.GetLatestCompletedRunReportAsync(scheduleId).GetAwaiter().GetResult();
                AppendScheduleResult(output, scheduleResult);
            }
            else
            {
                output.AppendLine("=== ScheduleId workflow SKIPPED (no valid ScheduleId supplied) ===");
            }

            // ---- Test 2: RunListId workflow ----
            if (Guid.TryParse(runListIdRaw, out var runListId) && runListId != Guid.Empty)
            {
                output.AppendLine();
                output.AppendLine("=== RunListId workflow ===");
                var runListResult = runListService.GetLatestCompletedRunReportForRunListAsync(runListId).GetAwaiter().GetResult();
                AppendRunListResult(output, runListResult);
            }
            else
            {
                output.AppendLine();
                output.AppendLine("=== RunListId workflow SKIPPED (no valid RunListId supplied) ===");
            }
        }
        catch (LeapworkValidationException ex)
        {
            output.AppendLine("VALIDATION ERROR: " + ex.Message);
        }
        catch (LeapworkApiException ex)
        {
            // Never contains the AccessKey — safe to log/output as-is.
            output.AppendLine("API ERROR: " + ex.Message);
        }
        catch (Exception ex)
        {
            output.AppendLine("UNEXPECTED ERROR: " + ex.Message);
        }

        return output.ToString();
    }

    private static void AppendScheduleResult(StringBuilder output, ScheduleRunReportResult result)
    {
        if (!result.Success)
        {
            output.AppendLine("No report: " + result.NoCompletedRunReason);
            return;
        }

        var report = result.Report!;
        output.AppendLine($"RunId: {report.Summary.RunId} | CreatedAt: {report.Summary.CreatedAt:u} | Status: {report.Summary.Status}");
        output.AppendLine($"Official totals -> Passed: {report.Summary.Passed}  Failed: {report.Summary.Failed}  Done: {report.Summary.Done}  Total: {report.Summary.Total}");

        if (!report.Reconciliation.Matches)
        {
            output.AppendLine("RECONCILIATION WARNING: " + report.Reconciliation.Warning);
        }
        else
        {
            output.AppendLine("Reconciliation: official and calculated totals match.");
        }

        output.AppendLine($"RunItems ({report.RunItems.Count}):");
        foreach (var item in report.RunItems)
        {
            AppendRunItemLine(output, item);
        }
    }

    private static void AppendRunListResult(StringBuilder output, RunListReportResult result)
    {
        if (!result.Success)
        {
            output.AppendLine("No report: " + result.StatusMessage);
            return;
        }

        var report = result.Report!;
        output.AppendLine($"RunListId: {report.RunListId} ({report.RunListTitle ?? "(no title)"})");
        output.AppendLine($"Selected ScheduleId: {report.SelectedScheduleId} ({report.SelectedScheduleTitle ?? "(no title)"})");
        output.AppendLine($"RunId: {report.Summary.RunId} | CreatedAt: {report.Summary.CreatedAt:u} | Status: {report.Summary.Status}");
        output.AppendLine($"Official totals -> Passed: {report.Summary.Passed}  Failed: {report.Summary.Failed}  Done: {report.Summary.Done}  Total: {report.Summary.Total}");

        if (!report.Reconciliation.Matches)
        {
            output.AppendLine("RECONCILIATION WARNING: " + report.Reconciliation.Warning);
        }
        else
        {
            output.AppendLine("Reconciliation: official and calculated totals match.");
        }

        output.AppendLine($"RunItems ({report.RunItems.Count}):");
        foreach (var item in report.RunItems)
        {
            AppendRunItemLine(output, item);
        }
    }

    private static void AppendRunItemLine(StringBuilder output, RunItemResult item)
    {
        if (item.HasRetrievalError)
        {
            output.AppendLine($"  - RunItemId: {item.RunItemId} | RETRIEVAL ERROR: {item.RetrievalError}");
            return;
        }

        output.AppendLine(
            $"  - {item.FlowTitle} | Agent: {item.AgentTitle} | Status: {item.Status} (raw: {item.RawStatus}) | " +
            $"Retry: {item.RetryAttempt} | FailReason: {item.FailReason ?? "none"} | " +
            $"Start: {item.StartTime:u} | Duration: {item.Duration}");
    }
}
