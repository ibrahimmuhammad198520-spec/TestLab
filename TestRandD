using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Implements the end-to-end workflow from spec section 16:
    /// ScheduleId → historical RunIds → candidate run details → latest Finished run
    /// (selected by CreatedAt) → run totals → RunItemIds → per-RunItem detail.
    /// </summary>
    public sealed class LeapworkReportService
    {
        private readonly LeapworkApiClient _client;
        private readonly LeapworkClientOptions _options;

        public LeapworkReportService(LeapworkApiClient client, LeapworkClientOptions options)
        {
            _client = client ?? throw new ArgumentNullException(nameof(client));
            _options = options ?? throw new ArgumentNullException(nameof(options));
        }

        /// <summary>
        /// Retrieves the latest completed (Status = Finished) run for the given schedule, along
        /// with per-RunItem detail. Never starts a new execution. All calls are HTTP GET.
        /// </summary>
        /// <param name="scheduleId">Required. The integration must not search by schedule title.</param>
        /// <param name="lookbackDaysOverride">
        /// Optional override of DefaultLookbackDays. If no Finished run is found within this
        /// window, the caller may retry with a larger value (spec section 14) — this method does
        /// not auto-escalate, to keep the search window explicit and caller-controlled.
        /// </param>
        public async Task<ScheduleRunReportResult> GetLatestCompletedRunReportAsync(
            Guid scheduleId,
            int? lookbackDaysOverride = null,
            CancellationToken ct = default)
        {
            if (scheduleId == Guid.Empty)
                throw new LeapworkValidationException("ScheduleId is required.");

            var lookbackDays = lookbackDaysOverride ?? _options.DefaultLookbackDays;
            if (lookbackDays <= 0)
                throw new LeapworkValidationException("LookbackDays must be a positive number of days.");

            // 1-2. Historical RunIds and candidate run details for the schedule.
            var candidates = await CollectFinishedCandidatesAsync(new[] { scheduleId }, lookbackDays, ct).ConfigureAwait(false);

            if (candidates.Count == 0)
            {
                return ScheduleRunReportResult.NoRun(
                    $"Schedule '{scheduleId}' has no execution history in the last {lookbackDays} day(s). " +
                    "Consider increasing LookbackDays and searching again.");
            }

            // 3-5. Remove Queued/Executing, sort remaining Finished runs by CreatedAt desc, select first.
            var latest = SelectLatestFinished(candidates);

            if (latest is null)
            {
                return ScheduleRunReportResult.NoRun("No completed run found for ScheduleId.");
            }

            // 6-7. RunItemIds and per-item detail for the selected run.
            var runItems = await RetrieveRunItemResultsAsync(latest.RunId, ct).ConfigureAwait(false);

            // 8. Consolidated response.
            var report = new ScheduleRunReport
            {
                Summary = latest,
                RunItems = runItems,
                Reconciliation = CalculateReconciliation(latest, runItems)
            };

            return ScheduleRunReportResult.Ok(report);
        }

        /// <summary>
        /// Collects run-detail candidates across one or more ScheduleIds: fetches historical
        /// RunIds for each schedule, then fetches each candidate run's detail. Reused by both the
        /// single-ScheduleId workflow and the RunListId workflow (which spans multiple schedules).
        /// A schedule or run that fails to read is skipped rather than aborting the whole search.
        /// </summary>
        internal async Task<List<RunSummary>> CollectFinishedCandidatesAsync(
            IReadOnlyList<Guid> scheduleIds, int lookbackDays, CancellationToken ct)
        {
            var candidates = new List<RunSummary>();

            foreach (var scheduleId in scheduleIds)
            {
                List<Guid> runIds;
                try
                {
                    runIds = await _client.GetRunIdsLastDaysAsync(scheduleId, lookbackDays, ct).ConfigureAwait(false);
                }
                catch (LeapworkApiException)
                {
                    continue;
                }

                foreach (var runId in runIds)
                {
                    try
                    {
                        var summary = await _client.GetRunAsync(runId, scheduleId, ct).ConfigureAwait(false);
                        candidates.Add(summary);
                    }
                    catch (LeapworkApiException)
                    {
                        continue;
                    }
                }
            }

            return candidates;
        }

        /// <summary>Filters to Status = Finished and picks the greatest CreatedAt, or null if none.</summary>
        internal static RunSummary? SelectLatestFinished(IEnumerable<RunSummary> candidates) =>
            candidates
                .Where(r => r.Status == RunStatus.Finished)
                .OrderByDescending(r => r.CreatedAt)
                .FirstOrDefault();

        /// <summary>
        /// Retrieves RunItemIds for a run and the detail of each, with per-item error isolation
        /// (spec sections 9 and 13). Reused by both the ScheduleId and RunListId workflows.
        /// </summary>
        internal async Task<List<RunItemResult>> RetrieveRunItemResultsAsync(Guid runId, CancellationToken ct)
        {
            var runItemIds = await _client.GetRunItemIdsAsync(runId, ct).ConfigureAwait(false);
            var runItems = new List<RunItemResult>(runItemIds.Count);

            foreach (var runItemId in runItemIds)
            {
                try
                {
                    var detail = await _client.GetRunItemAsync(runItemId, ct).ConfigureAwait(false);
                    FlagUnexpectedStatuses(detail);
                    runItems.Add(detail);
                }
                catch (LeapworkApiException ex)
                {
                    runItems.Add(new RunItemResult
                    {
                        RunItemId = runItemId,
                        Status = RunItemStatus.Unknown,
                        RawStatus = string.Empty,
                        RetrievalError = ex.Message
                    });
                }
            }

            return runItems;
        }

        /// <summary>
        /// Compares official run-level totals (Passed/Failed/Done/Total from GET /run/{runId})
        /// against totals calculated from the actually retrieved RunItems. The official totals
        /// are always retained; a mismatch produces a warning rather than overwriting them.
        /// Reused by both the ScheduleId and RunListId report-assembly paths.
        /// </summary>
        internal static ReconciliationResult CalculateReconciliation(RunSummary official, IReadOnlyList<RunItemResult> runItems)
        {
            var calculated = new RunItemTotals
            {
                Passed = runItems.Count(i => i.Status == RunItemStatus.Passed),
                Failed = runItems.Count(i => i.Status == RunItemStatus.Failed),
                Done = runItems.Count(i => i.Status == RunItemStatus.Done),
                Total = runItems.Count
            };

            var differences = new List<string>();
            if (calculated.Passed != official.Passed) differences.Add($"Passed (official {official.Passed} vs calculated {calculated.Passed})");
            if (calculated.Failed != official.Failed) differences.Add($"Failed (official {official.Failed} vs calculated {calculated.Failed})");
            if (calculated.Done != official.Done) differences.Add($"Done (official {official.Done} vs calculated {calculated.Done})");
            if (calculated.Total != official.Total) differences.Add($"Total (official {official.Total} vs calculated {calculated.Total})");

            var matches = differences.Count == 0;
            var warning = matches
                ? null
                : "Official run totals do not match calculated RunItem totals: " + string.Join("; ", differences) +
                  ". Official totals are retained as authoritative. Possible causes: retry attempts, cancelled items, " +
                  "technical errors, missing RunItem responses, statuses not represented in the standard totals, or " +
                  "version-specific LEAPWORK counting behavior.";

            return new ReconciliationResult
            {
                CalculatedTotals = calculated,
                Matches = matches,
                Warning = warning
            };
        }

        /// <summary>
        /// Sets FailReason context for statuses that are unexpected on an already-Finished run
        /// (spec section 10: IsProcessing / NoStatus / Unknown should be flagged, not silently
        /// treated as pass/fail).
        /// </summary>
        private static void FlagUnexpectedStatuses(RunItemResult item)
        {
            switch (item.Status)
            {
                case RunItemStatus.IsProcessing:
                    item.FailReason ??= "Unexpected: RunItem reports IsProcessing on a run whose parent Run.Status is Finished.";
                    break;
                case RunItemStatus.NoStatus:
                    item.FailReason ??= "Unexpected: RunItem has no usable status; flagged for investigation.";
                    break;
                case RunItemStatus.Unknown:
                    item.FailReason ??= $"Unexpected/unrecognized RunItem status value: '{item.RawStatus}'.";
                    break;
            }
        }
    }
}
