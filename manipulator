using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Http;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Thin, read-only wrapper over the four Leapwork Controller v4 endpoints used by this
    /// workflow. Issues GET requests only; never calls runNow or any state-changing endpoint.
    /// </summary>
    public sealed class LeapworkApiClient
    {
        private readonly HttpClient _http;
        private readonly LeapworkClientOptions _options;
        private static readonly JsonSerializerOptions JsonOpts = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true
        };

        /// <param name="httpClient">
        /// Caller-owned HttpClient. BaseAddress and the AccessKey header are configured here;
        /// the caller remains responsible for the HttpClient's lifetime (DI container, etc.).
        /// </param>
        public LeapworkApiClient(HttpClient httpClient, LeapworkClientOptions options)
        {
            _http = httpClient ?? throw new ArgumentNullException(nameof(httpClient));
            _options = options ?? throw new ArgumentNullException(nameof(options));

            if (string.IsNullOrWhiteSpace(options.ControllerUrl))
                throw new LeapworkValidationException("ControllerUrl is required.");
            if (string.IsNullOrWhiteSpace(options.AccessKey))
                throw new LeapworkValidationException("AccessKey is required.");

            var baseUrl = options.ControllerUrl.EndsWith("/") ? options.ControllerUrl : options.ControllerUrl + "/";
            _http.BaseAddress = new Uri(baseUrl);

            if (_http.DefaultRequestHeaders.Contains("AccessKey"))
                _http.DefaultRequestHeaders.Remove("AccessKey");
            _http.DefaultRequestHeaders.Add("AccessKey", options.AccessKey);

            if (!_http.DefaultRequestHeaders.Accept.Contains(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("application/json")))
                _http.DefaultRequestHeaders.Accept.Add(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("application/json"));

            if (options.RequestTimeout.HasValue)
                _http.Timeout = options.RequestTimeout.Value;
        }

        /// <summary>GET /schedules/{scheduleId}/runIds/LastDays?count={lookbackDays}</summary>
        public Task<List<Guid>> GetRunIdsLastDaysAsync(Guid scheduleId, int lookbackDays, CancellationToken ct = default)
        {
            var path = $"schedules/{scheduleId}/runIds/LastDays?count={lookbackDays}";
            return GetJsonAsync<List<Guid>>(path, ct, () => new List<Guid>());
        }

        /// <summary>GET /run/{runId}</summary>
        public async Task<RunSummary> GetRunAsync(Guid runId, Guid scheduleId, CancellationToken ct = default)
        {
            var path = $"run/{runId}";
            var dto = await GetJsonAsync<RunDto>(path, ct).ConfigureAwait(false);
            return MapRunSummary(dto, scheduleId);
        }

        /// <summary>GET /run/{runId}/runItemIds</summary>
        public Task<List<Guid>> GetRunItemIdsAsync(Guid runId, CancellationToken ct = default)
        {
            var path = $"run/{runId}/runItemIds";
            return GetJsonAsync<List<Guid>>(path, ct, () => new List<Guid>());
        }

        /// <summary>GET /runItems/{runItemId}</summary>
        public async Task<RunItemResult> GetRunItemAsync(Guid runItemId, CancellationToken ct = default)
        {
            var path = $"runItems/{runItemId}";
            var dto = await GetJsonAsync<RunItemDto>(path, ct).ConfigureAwait(false);
            return MapRunItemResult(dto, runItemId);
        }

        // ---- internals ----

        private async Task<T> GetJsonAsync<T>(string relativePath, CancellationToken ct, Func<T>? emptyFallback = null)
        {
            HttpResponseMessage response;
            try
            {
                response = await _http.GetAsync(relativePath, ct).ConfigureAwait(false);
            }
            catch (TaskCanceledException ex) when (!ct.IsCancellationRequested)
            {
                throw new LeapworkApiException($"Request to '{relativePath}' timed out.", null, relativePath, ex);
            }
            catch (HttpRequestException ex)
            {
                throw new LeapworkApiException($"Network error calling '{relativePath}': {ex.Message}", null, relativePath, ex);
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
                throw LeapworkApiException.Unauthorized(relativePath);

            if (response.StatusCode == HttpStatusCode.NotFound)
                throw LeapworkApiException.NotFound(relativePath);

            if (!response.IsSuccessStatusCode)
            {
                throw new LeapworkApiException(
                    $"Request to '{relativePath}' failed with status {(int)response.StatusCode} {response.StatusCode}.",
                    response.StatusCode, relativePath);
            }

            var body = await response.Content.ReadAsStringAsync(ct).ConfigureAwait(false);

            if (string.IsNullOrWhiteSpace(body))
            {
                if (emptyFallback != null) return emptyFallback();
                throw new LeapworkApiException($"Request to '{relativePath}' returned an empty body.", response.StatusCode, relativePath);
            }

            try
            {
                var result = JsonSerializer.Deserialize<T>(body, JsonOpts);
                if (result is null)
                {
                    if (emptyFallback != null) return emptyFallback();
                    throw new LeapworkApiException($"Request to '{relativePath}' returned an unparsable/null payload.", response.StatusCode, relativePath);
                }
                return result;
            }
            catch (JsonException ex)
            {
                throw new LeapworkApiException($"Failed to parse response from '{relativePath}': {ex.Message}", response.StatusCode, relativePath, ex);
            }
        }

        private static RunSummary MapRunSummary(RunDto dto, Guid scheduleId)
        {
            return new RunSummary
            {
                ScheduleId = scheduleId,
                RunId = dto.RunId ?? dto.Id ?? Guid.Empty,
                CreatedAt = dto.CreatedAt ?? DateTimeOffset.MinValue,
                Status = ParseRunStatus(dto.Status),
                RawStatus = dto.Status ?? string.Empty,
                Passed = dto.Passed ?? 0,
                Failed = dto.Failed ?? 0,
                Done = dto.Done ?? 0,
                Total = dto.Total ?? 0
            };
        }

        private static RunItemResult MapRunItemResult(RunItemDto dto, Guid requestedId)
        {
            TimeSpan? duration = null;
            if (dto.StartTime.HasValue && dto.EndTime.HasValue && dto.EndTime.Value >= dto.StartTime.Value)
                duration = dto.EndTime.Value - dto.StartTime.Value;
            else if (dto.Duration.HasValue)
                duration = TimeSpan.FromSeconds(dto.Duration.Value);

            return new RunItemResult
            {
                RunItemId = dto.RunItemId ?? dto.Id ?? requestedId,
                FlowId = dto.FlowId,
                FlowTitle = dto.FlowTitle,
                AgentId = dto.AgentId,
                AgentTitle = dto.AgentTitle,
                Status = ParseRunItemStatus(dto.Status),
                RawStatus = dto.Status ?? string.Empty,
                FlowInfoStatus = dto.FlowInfo?.Status,
                RetryAttempt = dto.RetryAttempt ?? 0,
                FailReason = dto.FailReason,
                StartTime = dto.StartTime,
                EndTime = dto.EndTime,
                Duration = duration
            };
        }

        internal static RunStatus ParseRunStatus(string? raw)
        {
            if (string.IsNullOrWhiteSpace(raw)) return RunStatus.Unknown;
            return raw.Trim().ToLowerInvariant() switch
            {
                "queued" => RunStatus.Queued,
                "executing" => RunStatus.Executing,
                "finished" => RunStatus.Finished,
                _ => RunStatus.Unknown
            };
        }

        internal static RunItemStatus ParseRunItemStatus(string? raw)
        {
            if (string.IsNullOrWhiteSpace(raw)) return RunItemStatus.NoStatus;
            return raw.Trim().ToLowerInvariant() switch
            {
                "passed" => RunItemStatus.Passed,
                "failed" => RunItemStatus.Failed,
                "done" => RunItemStatus.Done,
                "cancelled" => RunItemStatus.Cancelled,
                "canceled" => RunItemStatus.Cancelled,
                "error" => RunItemStatus.Error,
                "isprocessing" => RunItemStatus.IsProcessing,
                "processing" => RunItemStatus.IsProcessing,
                "nostatus" => RunItemStatus.NoStatus,
                "" => RunItemStatus.NoStatus,
                _ => RunItemStatus.Unknown
            };
        }

        // ---- raw DTOs matching the Controller v4 JSON shape ----

        private sealed class RunDto
        {
            public Guid? RunId { get; set; }
            public Guid? Id { get; set; }
            public DateTimeOffset? CreatedAt { get; set; }
            public string? Status { get; set; }
            public int? Passed { get; set; }
            public int? Failed { get; set; }
            public int? Done { get; set; }
            public int? Total { get; set; }
        }

        private sealed class RunItemDto
        {
            public Guid? RunItemId { get; set; }
            public Guid? Id { get; set; }
            public Guid? FlowId { get; set; }
            public string? FlowTitle { get; set; }
            public Guid? AgentId { get; set; }
            public string? AgentTitle { get; set; }
            public string? Status { get; set; }
            public int? RetryAttempt { get; set; }
            public string? FailReason { get; set; }
            public DateTimeOffset? StartTime { get; set; }
            public DateTimeOffset? EndTime { get; set; }
            public double? Duration { get; set; }
            public FlowInfoDto? FlowInfo { get; set; }
        }

        private sealed class FlowInfoDto
        {
            public string? Status { get; set; }
        }
    }
}

