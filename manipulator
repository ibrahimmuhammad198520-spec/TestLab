using System;
using System.Net;

namespace Leapwork.ReportClient
{
    /// <summary>Thrown when required inputs (ControllerUrl, AccessKey, ScheduleId) are missing or invalid.</summary>
    public sealed class LeapworkValidationException : Exception
    {
        public LeapworkValidationException(string message) : base(message) { }
    }

    /// <summary>
    /// Thrown for HTTP/API failures. Never includes the AccessKey value in its Message,
    /// per spec section 3 ("must never appear in ... error messages").
    /// </summary>
    public sealed class LeapworkApiException : Exception
    {
        public HttpStatusCode? StatusCode { get; }
        public string? RequestUrl { get; }

        public LeapworkApiException(string message, HttpStatusCode? statusCode = null, string? requestUrl = null, Exception? inner = null)
            : base(message, inner)
        {
            StatusCode = statusCode;
            RequestUrl = requestUrl;
        }

        public static LeapworkApiException Unauthorized(string requestUrl) =>
            new LeapworkApiException(
                "Authentication failed (401 Unauthorized). Verify the AccessKey header value is correct and has not expired.",
                HttpStatusCode.Unauthorized, requestUrl);

        public static LeapworkApiException NotFound(string requestUrl) =>
            new LeapworkApiException(
                "Resource not found (404). Verify the ControllerUrl, ScheduleId, RunId, or RunItemId.",
                HttpStatusCode.NotFound, requestUrl);
    }
}

