using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

namespace Leapwork.ReportClient
{
    /// <summary>
    /// Implements the end-to-end workflow from spec section 16:
    /// ScheduleId → historical RunIds → candidate run details → latest Finished run
    /// (selected by CreatedAt) → run totals → RunItemIds → per-RunItem detail.
    /// </summary>
    public sealed class LeapworkReportService
    {
        private readonly LeapworkApiClient _client;
        private readonly LeapworkClientOptions _options;

        public LeapworkReportService(LeapworkApiClient client, LeapworkClientOptions options)
        {
            _client = client ?? throw new ArgumentNullException(nameof(client));
            _options = options ?? throw new ArgumentNullException(nameof(options));
        }

        /// <summary>
        /// Retrieves the latest completed (Status = Finished) run for the given schedule, along
        /// with per-RunItem detail. Never starts a new execution. All calls are HTTP GET.
        /// </summary>
        /// <param name="scheduleId">Required. The integration must not search by schedule title.</param>
        /// <param name="lookbackDaysOverride">
        /// Optional override of DefaultLookbackDays. If no Finished run is found within this
        /// window, the caller may retry with a larger value (spec section 14) — this method does
        /// not auto-escalate, to keep the search window explicit and caller-controlled.
        /// </param>
        public async Task<ScheduleRunReportResult> GetLatestCompletedRunReportAsync(
            Guid scheduleId,
            int? lookbackDaysOverride = null,
            CancellationToken ct = default)
        {
            if (scheduleId == Guid.Empty)
                throw new LeapworkValidationException("ScheduleId is required.");

            var lookbackDays = lookbackDaysOverride ?? _options.DefaultLookbackDays;
            if (lookbackDays <= 0)
                throw new LeapworkValidationException("LookbackDays must be a positive number of days.");

            // 1. Historical RunIds for the schedule.
            var runIds = await _client.GetRunIdsLastDaysAsync(scheduleId, lookbackDays, ct).ConfigureAwait(false);
            if (runIds.Count == 0)
            {
                return ScheduleRunReportResult.NoRun(
                    $"Schedule '{scheduleId}' has no execution history in the last {lookbackDays} day(s). " +
                    "Consider increasing LookbackDays and searching again.");
            }

            // 2. Details of every candidate run.
            var candidates = new List<RunSummary>(runIds.Count);
            foreach (var runId in runIds)
            {
                // Individual run-detail failures are not fatal to the overall search; a run that
                // cannot be read is simply excluded from candidacy rather than aborting the whole
                // request (mirrors the "partial API failure" tolerance in spec section 13).
                try
                {
                    var summary = await _client.GetRunAsync(runId, scheduleId, ct).ConfigureAwait(false);
                    candidates.Add(summary);
                }
                catch (LeapworkApiException)
                {
                    // Skip unreadable run; do not let it block selection of a valid latest run.
                    continue;
                }
            }

            // 3-5. Remove Queued/Executing, sort remaining Finished runs by CreatedAt desc, select first.
            var latest = candidates
                .Where(r => r.Status == RunStatus.Finished)
                .OrderByDescending(r => r.CreatedAt)
                .FirstOrDefault();

            if (latest is null)
            {
                return ScheduleRunReportResult.NoRun("No completed run found for ScheduleId.");
            }

            // 6. RunItemIds belonging to the selected run.
            var runItemIds = await _client.GetRunItemIdsAsync(latest.RunId, ct).ConfigureAwait(false);

            // 7. Detailed result for every RunItemId, with per-item error isolation.
            var runItems = new List<RunItemResult>(runItemIds.Count);
            foreach (var runItemId in runItemIds)
            {
                try
                {
                    var detail = await _client.GetRunItemAsync(runItemId, ct).ConfigureAwait(false);
                    FlagUnexpectedStatuses(detail);
                    runItems.Add(detail);
                }
                catch (LeapworkApiException ex)
                {
                    // Preserve the RunItemId with an explicit retrieval error instead of dropping it
                    // (spec sections 9 and 13).
                    runItems.Add(new RunItemResult
                    {
                        RunItemId = runItemId,
                        Status = RunItemStatus.Unknown,
                        RawStatus = string.Empty,
                        RetrievalError = ex.Message
                    });
                }
            }

            // 8. Consolidated response.
            var report = new ScheduleRunReport
            {
                Summary = latest,
                RunItems = runItems
            };

            return ScheduleRunReportResult.Ok(report);
        }

        /// <summary>
        /// Sets FailReason context for statuses that are unexpected on an already-Finished run
        /// (spec section 10: IsProcessing / NoStatus / Unknown should be flagged, not silently
        /// treated as pass/fail).
        /// </summary>
        private static void FlagUnexpectedStatuses(RunItemResult item)
        {
            switch (item.Status)
            {
                case RunItemStatus.IsProcessing:
                    item.FailReason ??= "Unexpected: RunItem reports IsProcessing on a run whose parent Run.Status is Finished.";
                    break;
                case RunItemStatus.NoStatus:
                    item.FailReason ??= "Unexpected: RunItem has no usable status; flagged for investigation.";
                    break;
                case RunItemStatus.Unknown:
                    item.FailReason ??= $"Unexpected/unrecognized RunItem status value: '{item.RawStatus}'.";
                    break;
            }
        }
    }
}

