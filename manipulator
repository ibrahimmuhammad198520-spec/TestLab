var options = new LeapworkClientOptions
{
    ControllerUrl = "https://controller.example.com/api/v4/",
    AccessKey = Environment.GetEnvironmentVariable("LEAPWORK_ACCESS_KEY")!,
    DefaultLookbackDays = 30
};

using var httpClient = new HttpClient();
var apiClient = new LeapworkApiClient(httpClient, options);
var reportService = new LeapworkReportService(apiClient, options);

var result = await reportService.GetLatestCompletedRunReportAsync(scheduleId);

if (!result.Success)
{
    Console.WriteLine(result.NoCompletedRunReason);
    // e.g. retry with a larger lookbackDaysOverride
    return;
}

var report = result.Report!;
Console.WriteLine($"Run {report.Summary.RunId}: {report.Summary.Passed}/{report.Summary.Total} passed");

foreach (var item in report.RunItems)
{
    if (item.HasRetrievalError)
    {
        Console.WriteLine($"RunItem {item.RunItemId}: retrieval error - {item.RetrievalError}");
        continue;
    }
    Console.WriteLine($"{item.FlowTitle} on {item.AgentTitle} (retry {item.RetryAttempt}): {item.Status}");
}


